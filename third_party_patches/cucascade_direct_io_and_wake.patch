+TEST_CASE("disk memory_space with direct_io reads back what it wrote", "[disk][io][memory_space]")
+{
+  // A directory that takes O_DIRECT: the system temp directory is often tmpfs, which does not.
+  auto const dir       = std::filesystem::current_path();
+  auto const file_path = dir / "test_direct_io_space.bin";
+  int const probe      = ::open(file_path.c_str(), O_CREAT | O_WRONLY | O_DIRECT, 0600);
+  if (probe < 0) { SKIP("the test directory's filesystem does not take O_DIRECT"); }
+  ::close(probe);
+
+  cucascade::memory::disk_memory_space_config config{0, 1024 * 1024 * 1024, dir.string()};
+  config.direct_io = true;
+  cucascade::memory::memory_space space(config);
+
+  // Device memory goes through the O_DIRECT path (host metadata never does). The size is not a
+  // multiple of the 512-byte direct I/O block, so the padded tail is exercised.
+  std::vector<uint8_t> write_data(8 * 1024 * 1024 + 100);
+  std::iota(write_data.begin(), write_data.end(), static_cast<uint8_t>(0));
+  rmm::cuda_stream stream;
+  ::cuda::stream_ref const stream_ref{stream.value()};
+  rmm::device_buffer written(write_data.data(), write_data.size(), stream_ref);
+  space.get_io_backend().write(file_path, written.data(), written.size(), 0, stream_ref);
+
+  rmm::device_buffer read_back(write_data.size(), stream_ref);
+  space.get_io_backend().read(file_path, read_back.data(), read_back.size(), 0, stream_ref);
+  std::vector<uint8_t> read_data(write_data.size(), 0);
+  REQUIRE(cudaMemcpy(read_data.data(), read_back.data(), read_data.size(), cudaMemcpyDeviceToHost) ==
+          cudaSuccess);
+  REQUIRE(write_data == read_data);
+
+  std::filesystem::remove(file_path);
+}
+
+TEST_CASE("disk memory_space with direct_io falls back where O_DIRECT is refused",
+          "[disk][io][memory_space]")
+{
+  // /dev/shm is tmpfs, which refuses O_DIRECT; anywhere that takes it has nothing to fall back from.
+  std::filesystem::path const dir{"/dev/shm"};
+  if (!std::filesystem::is_directory(dir)) { SKIP("no /dev/shm"); }
+  auto const file_path = dir / "test_direct_io_fallback.bin";
+  int const probe      = ::open(file_path.c_str(), O_CREAT | O_WRONLY | O_DIRECT, 0600);
+  if (probe >= 0) {
+    ::close(probe);
+    std::filesystem::remove(file_path);
+    SKIP("/dev/shm takes O_DIRECT here");
+  }
+
+  cucascade::memory::disk_memory_space_config config{0, 1024 * 1024 * 1024, dir.string()};
+  config.direct_io = true;
+  cucascade::memory::memory_space space(config);
+
+  std::vector<uint8_t> write_data(1024 * 1024 + 100);
+  std::iota(write_data.begin(), write_data.end(), static_cast<uint8_t>(0));
+  rmm::cuda_stream stream;
+  ::cuda::stream_ref const stream_ref{stream.value()};
+  rmm::device_buffer written(write_data.data(), write_data.size(), stream_ref);
+  REQUIRE_NOTHROW(
+    space.get_io_backend().write(file_path, written.data(), written.size(), 0, stream_ref));
+
+  rmm::device_buffer read_back(write_data.size(), stream_ref);
+  REQUIRE_NOTHROW(
+    space.get_io_backend().read(file_path, read_back.data(), read_back.size(), 0, stream_ref));
+  std::vector<uint8_t> read_data(write_data.size(), 0);
+  REQUIRE(cudaMemcpy(read_data.data(), read_back.data(), read_data.size(), cudaMemcpyDeviceToHost) ==
+          cudaSuccess);
+  REQUIRE(write_data == read_data);
+
+  std::filesystem::remove(file_path);
+}
