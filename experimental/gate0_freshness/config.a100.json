{
  "repo_root": "auto",
  "duckdb_binary": "build/release/duckdb",
  "ld_library_path": ".pixi/envs/default/lib",
  "data_dir": "/tmp/gate0_data",
  "dataset": {
    "kind": "tpch",
    "sf": 5,
    "refresh_sets": 450,
    "update_rows_per_tick": 5000
  },
  "workload": {
    "ticks": 15,
    "verify_every": 3
  },
  "churn": {
    "rhos": [0.001, 0.005, 0.01, 0.03]
  },
  "recompact_every": 5,
  "sweep_arms": ["cpu", "arm_a", "arm_b", "arm_c"],
  "engine_settings": [
    "SET scan_cache_level='table_gpu'"
  ],
  "box": {
    "name": "a100-dnguyen56",
    "gpu": "A100-SXM4-40GB",
    "cuda_arch": "80-real",
    "interconnect": "pcie4",
    "gpu_mem_gb": 40
  }
}
